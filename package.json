{
  "name": "@compas-bearingpoint/plugins",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npm run build:plugins-hub && npm run build:demo-theme",
    "build:plugins-hub": "nx run --prod plugins-hub:build --no-outputhashing --emptyOutDir --verbose",
    "build:demo-theme": "nx run --prod demo-theme:build --no-outputhashing --emptyOutDir --verbose",
    "run:plugins-hub": "nx run plugins-hub:serve",
    "run:demo-theme": "nx run demo-theme:serve",
    "preview:plugins-hub": "nx run plugins-hub:preview --configuration=development",
    "preview:plugins-hub-prod": "nx run --prod plugins-hub:preview",
    "preview:demo-theme": "nx run demo-theme:preview --configuration=development",
    "test:all": "nx run-many --target=test",
    "lint": "nx run-many --target=lint",
    "check": "nx run-many --target=check",
    "verify": "nx run-many --target=lint,check,test",
    "wiremock": "wiremock --root-dir=./wiremock --port=8181 --local-response-templating"
  },
  "private": true,
  "dependencies": {
    "svelte-material-ui": "^8.0.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@nx/eslint": "19.6.5",
    "@nx/eslint-plugin": "19.6.5",
    "@nx/js": "19.6.5",
    "@nx/vite": "19.6.5",
    "@nx/web": "19.6.5",
    "@nx/workspace": "19.6.5",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@testing-library/svelte": "^5.0.0",
    "@tsconfig/svelte": "^4.0.1",
    "@types/node": "18.16.9",
    "@typescript-eslint/eslint-plugin": "^7.3.0",
    "@typescript-eslint/parser": "^7.3.0",
    "@vitest/coverage-v8": "^1.0.4",
    "eslint": "~8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-svelte": "^2.36.0",
    "happy-dom": "^20.8.9",
    "nx": "19.6.5",
    "prettier": "^3.1.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "svelte-preprocess": "^6.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.4",
    "vitest": "^1.3.1",
    "wiremock": "^3.13.2"
  }
}
