{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "types": ["vitest/globals", "node", "vite/client"],
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "../../dist/out-tsc"
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.svelte",
    "src/**/*.test.svelte"
  ],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ],
}
